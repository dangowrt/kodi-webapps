<?xml version="1.0" encoding="UTF-8"?>
<addon id="webapp.netflix" name="Netflix" version="1.1.0" provider-name="Daniel Golle">
  <requires>
    <import addon="kodi.webapp" version="1.0.0"/>
  </requires>
  <extension point="kodi.webapp" starturl="https://www.netflix.com/">
    <useragent>Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/156.0.0.0 Safari/537.36</useragent>
    <userscript>profile/scripts/10-remote.js</userscript>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Netflix inside Kodi</summary>
    <description lang="en_GB">Opens Netflix in Kodi's web view, as Chrome on Linux sees the desktop site.</description>
    <platform>all</platform>
    <license>GPL-2.0-or-later</license>
    <source>https://github.com/dangowrt/kodi-webapps</source>
    <assets>
      <icon>https://upload.wikimedia.org/wikipedia/commons/thumb/7/75/Netflix_icon.svg/960px-Netflix_icon.svg.png</icon>
    </assets>
  </extension>
</addon>
