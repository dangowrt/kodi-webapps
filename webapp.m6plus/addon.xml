<?xml version="1.0" encoding="UTF-8"?>
<addon id="webapp.m6plus" name="M6+" version="1.0.0" provider-name="Daniel Golle">
  <requires>
    <import addon="kodi.webapp" version="1.0.0"/>
  </requires>
  <extension point="kodi.webapp" starturl="https://hbbtv--m6plus.6cloud.fr/">
    <useragent>Mozilla/5.0 (Linux; aarch64) AppleWebKit/605.1.15 (KHTML, like Gecko) WPE HbbTV/1.5.1 (; OpenWrt; Kodi; 22.0; ; Kodi;)</useragent>
    <userscript>profile/scripts/00-hbbtv-keys.js</userscript>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">The M6+ TV edition inside Kodi</summary>
    <description lang="en_GB">Opens the HbbTV edition of M6+, the streaming service of the French group M6, in Kodi's web view.</description>
    <platform>all</platform>
    <license>GPL-2.0-or-later</license>
    <source>https://github.com/dangowrt/kodi-webapps</source>
    <assets>
      <icon>https://upload.wikimedia.org/wikipedia/commons/thumb/f/f9/Logo_M6_%282020%29.svg/960px-Logo_M6_%282020%29.svg.png</icon>
    </assets>
  </extension>
</addon>
