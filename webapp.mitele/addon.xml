<?xml version="1.0" encoding="UTF-8"?>
<addon id="webapp.mitele" name="Mitele" version="1.0.0" provider-name="Daniel Golle">
  <requires>
    <import addon="kodi.webapp" version="1.0.0"/>
  </requires>
  <extension point="kodi.webapp" starturl="https://hbbtv.mitele.es/">
    <useragent>Mozilla/5.0 (Linux; aarch64) AppleWebKit/605.1.15 (KHTML, like Gecko) WPE HbbTV/1.5.1 (; OpenWrt; Kodi; 22.0; ; Kodi;)</useragent>
    <userscript>profile/scripts/00-hbbtv-keys.js</userscript>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">The Mitele TV edition inside Kodi</summary>
    <description lang="en_GB">Opens the HbbTV edition of Mitele, the streaming service of Mediaset España, in Kodi's web view.</description>
    <platform>all</platform>
    <license>GPL-2.0-or-later</license>
    <source>https://github.com/dangowrt/kodi-webapps</source>
    <assets>
      <icon>https://upload.wikimedia.org/wikipedia/commons/thumb/8/8a/Mitele_logo_%282016-2025%29.svg/960px-Mitele_logo_%282016-2025%29.svg.png</icon>
    </assets>
  </extension>
</addon>
