<?xml version="1.0" encoding="UTF-8"?>
<addon id="webapp.3satmediathek" name="3sat Mediathek" version="1.0.0" provider-name="Nick Hainke">
  <requires>
    <import addon="kodi.webapp" version="1.3.0"/>
    <import addon="webapp.module.hbbtv" version="1.0.0"/>
  </requires>
  <extension point="kodi.webapp" starturl="http://hbbtv.zdf.de/3satm/index.php">
    <viewport width="1280" height="720"/>
    <useragent>Mozilla/5.0 (Linux; aarch64) AppleWebKit/605.1.15 (KHTML, like Gecko) WPE HbbTV/1.5.1 (; OpenWrt; Kodi; 22.0; ; Kodi;)</useragent>
    <userscript addon="webapp.module.hbbtv">profile/scripts/hbbtv-scale.js</userscript>
    <userscript addon="webapp.module.hbbtv">profile/scripts/hbbtv.js</userscript>
    <userscript>profile/scripts/10-hbbtv.js</userscript>
    <contentfilter list="easylist"/>
    <contentfilter list="easyprivacy"/>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">The 3sat Mediathek TV edition inside Kodi</summary>
    <description lang="en_GB">Opens the HbbTV edition of the 3sat Mediathek, the streaming service of the cultural channel 3sat of ZDF, ORF, SRG and ARD, in Kodi's web view.</description>
    <platform>all</platform>
    <license>GPL-2.0-or-later</license>
    <source>https://github.com/dangowrt/kodi-webapps</source>
    <assets>
      <icon>https://www.3sat.de/static/img/appicons/android-chrome-512x512.png</icon>
    </assets>
  </extension>
</addon>
